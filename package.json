{
  "name": "moon-style",
  "version": "0.1.1",
  "description": "moon-style",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./vite": "./dist/vite-plugin-moon.js",
    "./icon": "./dist/icon.js"
  },
  "source": "lib/index.ts",
  "private": false,
  "engines": {
    "node": ">=14"
  },
  "type": "module",
  "scripts": {
    "copy-config": "cp -r ./moon.config.default.json ./dist/moon.config.default.json",
    "copy-config-schema": " cp -r ./moon.config.schema.json ./dist/moon.config.schema.json",
    "copy-html": "cp lib/icons-client.html dist/icons-client.html",
    "build": "pnpm test && rm -rf dist && rollup -c --exports auto && pnpm build-scriptsTs && pnpm copy-config && pnpm copy-config-schema && pnpm copy-html && chmod +x dist/moon.js dist/purge.js 2>/dev/null || true",
    "prod": "pnpm build && node ./scripts/publish.js && git push",
    "start": "vite",
    "build-scriptsTs": "pnpm tsc --build scripts.tsconfig.json",
    "delete-scriptsJS": "rm -rf ./scriptsJS",
    "moon": "node ./dist/moon.js",
    "just-test": "pnpm build && node ./dist/build.js",
    "test": "vitest run",
    "purge": "node ./dist/purge.js",
    "test-purge": "pnpm build-scriptsTs && node ./dist/purge.js",
    "postinstall": "chmod +x ./dist/moon.js ./dist/purge.js 2>/dev/null || true"
  },
  "bin": {
    "moon": "./dist/moon.js",
    "moon-purge": "./dist/purge.js"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.19.3",
    "@rollup/plugin-commonjs": "^22.0.2",
    "@rollup/plugin-node-resolve": "^14.1.0",
    "@types/node": "^25.3.0",
    "@types/react": "^18.0.33",
    "@types/react-dom": "^18.0.6",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^3.1.0",
    "autoprefixer": "^10.4.15",
    "babel-loader": "^8.2.5",
    "cssnano": "^6.0.1",
    "postcss": "^8.4.29",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.10.0",
    "rollup": "^3.29.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "@rollup/plugin-terser": "^0.4.4",
    "rollup-plugin-typescript2": "^0.34.1",
    "svgo": "^4.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^4.8.4",
    "vite": "^4.2.1",
    "vitest": "^4.0.18"
  },
  "files": [
    "dist",
    "Moon.Types.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "keywords": [],
  "tags": [],
  "dependencies": {
    "chokidar": "^5.0.0",
    "postcss-cli": "^10.1.0",
    "postcss-preset-env": "^9.1.3",
    "purgecss": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Owl3CM/Moon.git"
  },
  "homepage": "https://github.com/Owl3CM/Moon",
  "bugs": {
    "url": "https://github.com/Owl3CM/Moon/issues"
  },
  "license": "MIT"
}
