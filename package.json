{
  "name": "moon-style",
  "version": "0.2.0",
  "description": "Config-driven CSS utilities, themes, and SVG icon tooling for Vite and React.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite-plugin-moon.d.ts",
      "import": "./dist/vite-plugin-moon.js",
      "default": "./dist/vite-plugin-moon.js"
    },
    "./icon": {
      "types": "./dist/icon.d.ts",
      "import": "./dist/icon.js",
      "default": "./dist/icon.js"
    }
  },
  "source": "lib/index.ts",
  "private": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module",
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "copy-assets": "node ./scripts/copy-assets.mjs",
    "build": "pnpm test && pnpm clean && rollup -c --exports auto && pnpm build-scriptsTs && pnpm copy-assets",
    "verify:dist": "node ./scripts/verify-dist.mjs",
    "prepack": "pnpm build && pnpm verify:dist",
    "release:check": "pnpm prepack",
    "start": "vite",
    "typecheck": "tsc --noEmit",
    "build-scriptsTs": "tsc --build scripts.tsconfig.json",
    "moon": "node ./dist/moon.js",
    "test": "vitest run",
    "purge": "node ./dist/purge.js",
    "test-purge": "pnpm build-scriptsTs && node ./dist/purge.js"
  },
  "bin": {
    "moon": "./dist/moon.js",
    "moon-purge": "./dist/purge.js"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.19.3",
    "@rollup/plugin-commonjs": "^22.0.2",
    "@rollup/plugin-node-resolve": "^14.1.0",
    "@types/node": "^25.3.0",
    "@types/react": "^18.0.33",
    "@types/react-dom": "^18.0.6",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^3.1.0",
    "autoprefixer": "^10.4.15",
    "babel-loader": "^8.2.5",
    "cssnano": "^6.0.1",
    "postcss": "^8.4.29",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.10.0",
    "rollup": "^3.29.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "@rollup/plugin-terser": "^0.4.4",
    "rollup-plugin-typescript2": "^0.34.1",
    "ts-node": "^10.9.1",
    "typescript": "^4.8.4",
    "vite": "^4.2.1",
    "vitest": "^4.0.18"
  },
  "files": [
    "dist",
    "Moon.Types.d.ts",
    ".agent",
    "AGENTS.md",
    "lib/*.ts",
    "lib/*.tsx",
    "lib/builder",
    "lib/helpers",
    "lib/jit"
  ],
  "publishConfig": {
    "access": "public"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "keywords": [
    "css",
    "design-system",
    "icons",
    "vite"
  ],
  "dependencies": {
    "chokidar": "^5.0.0",
    "postcss-cli": "^10.1.0",
    "postcss-preset-env": "^9.1.3",
    "purgecss": "^5.0.0",
    "svgo": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Owl3CM/Moon.git"
  },
  "homepage": "https://github.com/Owl3CM/Moon",
  "bugs": {
    "url": "https://github.com/Owl3CM/Moon/issues"
  },
  "license": "MIT"
}
